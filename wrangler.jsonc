{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "social-media-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-12",
  "vars": {
    "ENVIRONMENT": "development",
    // Daily YouTube Data API unit budget. Tools hard-fail once it is reached.
    "QUOTA_DAILY_LIMIT": "10000",
    // "true" makes every write tool refuse. Useful while testing.
    "READ_ONLY": "false"
  },
  "kv_namespaces": [
    {
      "binding": "SOCIAL_KV"
    }
  ],
  "env": {
    "production": {
      "vars": {
        "ENVIRONMENT": "production",
        "QUOTA_DAILY_LIMIT": "10000",
        "READ_ONLY": "false"
      },
      "kv_namespaces": [
        {
          "binding": "SOCIAL_KV"
        }
      ]
    }
  },
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.html"],
      "fallthrough": true
    }
  ]
}
